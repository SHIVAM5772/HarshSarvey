# Copy to .env.local. Admin setup: docs/ADMIN_SETUP.md.
# These settings stay on the server. Do not add NEXT_PUBLIC_ prefixes.
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MongoDB Atlas connection string; encode special characters in its password.
MONGODB_URI=
MONGODB_DB=Harsh
# Used only by npm run admin:create. Omit ADMIN_PASSWORD to generate one.
ADMIN_USERNAME=RamKumar
ADMIN_PASSWORD=

# Email OTP delivery (Gmail: use an App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# MAIL_FROM is also accepted instead of SMTP_FROM.

# Share ONLY the enquiry spreadsheet with this service account as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Inquiries
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep quotes and escaped newlines, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Enable only behind a trusted host that overwrites x-forwarded-for.
TRUST_PROXY_HEADERS=false
